    {"x": 0.55, "y": 2.17, "w": 10.9, "text": "Only handles 0 and 1 can be redirected, so handle 2 always reaches the screen.\nA | B runs A with output to a temporary file, then B with input from it: one after the other.", "size": 13.5, "style": "italic", "kind": "dos"},
    {"x": 0.55, "y": 4.92, "w": 10.9, "text": "Any descriptor can be redirected (2>, 2>&1), and the shell's own descriptors never change.\na | b is a pipe(2) between two children that run at the same time.", "size": 13.5, "style": "italic", "kind": "bsd"}
  ]
