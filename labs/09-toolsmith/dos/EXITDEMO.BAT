@ECHO OFF
REM EXITDEMO.BAT -- what IF ERRORLEVEL really tests (section 9.4)
RC 44
IF ERRORLEVEL 44 ECHO after RC 44:  IF ERRORLEVEL 44 is true
IF ERRORLEVEL 45 ECHO after RC 44:  IF ERRORLEVEL 45 is true
IF NOT ERRORLEVEL 45 ECHO after RC 44:  IF NOT ERRORLEVEL 45 is true
IF ERRORLEVEL 300 ECHO after RC 44:  IF ERRORLEVEL 300 is true
ECHO an internal command
IF ERRORLEVEL 44 ECHO after ECHO:   ERRORLEVEL is still 44 or more
RC 300
IF ERRORLEVEL 44 ECHO after RC 300: IF ERRORLEVEL 44 is true
IF ERRORLEVEL 45 ECHO after RC 300: IF ERRORLEVEL 45 is true
NOSUCH
IF ERRORLEVEL 44 ECHO after NOSUCH: ERRORLEVEL is still 44 or more
RC 0
IF NOT ERRORLEVEL 1 ECHO after RC 0:   IF NOT ERRORLEVEL 1 is true
